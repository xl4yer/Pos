@page "/sales"
@attribute [StreamRendering(true)]
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject ILocalStorageService Loc
@using System.Net.Http.Headers
@inject ISnackbar SnackBar
@inject IDialogService Dialog
@using DocumentFormat.OpenXml
@using DocumentFormat.OpenXml.Packaging
@using DocumentFormat.OpenXml.Spreadsheet
@inject IJSRuntime IJS

<PageTitle>Sales Report</PageTitle>

<style type="text/css">
    .centered {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 80vh;
    }
</style>

<div class="container mt-5">
    @if (p == null || p.Length == 0)
    {
        <div class="centered">
            <div class="loader"></div>
        </div>
    }
    else
    {
        <MudTable Class="ma-5" Dense="true" Hover="true" Items="@p" HorizontalScrollbar="true" FixedHeader="@fixed_header" FixedFooter="@fixed_footer" Height="@(fixed_header || fixed_footer ? "455px" : "")">
            <ToolBarContent>
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" @onclick="Refresh" Variant="Variant.Filled" Color="MudBlazor.Color.Tertiary" Size="Size.Small" /> &nbsp; &nbsp;                    
                <MudSpacer />
                <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Success" Size="Size.Small" @onclick="ExportToExcel">Export to Excel</MudButton>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<purchase, object>(c => c.date)" InitialDirection="SortDirection.Descending">
                        Date
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>Product Code</MudTh>
                <MudTh>Product Name</MudTh>
                <MudTh>Price</MudTh>
                <MudTh>Qty</MudTh>
                <MudTh>Total</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.date</MudTd>
                <MudTd>@context.code</MudTd>
                <MudTd>@context.name</MudTd>
                <MudTd>@context.price</MudTd>
                <MudTd>@context.quantity</MudTd>
                <MudTd>@context.total</MudTd>

            </RowTemplate>
        </MudTable>

    }
</div>



@code {
    private purchase[]? p;
    List<purchase> PList = new List<purchase>();
    bool fixed_header = true;
    bool fixed_footer = false;

    private async Task Refresh()
    {
        await GetSales();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {

        if (firstRender)
        {
            await GetSales();
            StateHasChanged();
        }
    }

    private async Task ExportToExcel()
    {
        if (p == null || p.Length == 0)
            return;

        using MemoryStream ms = new MemoryStream();
        using (SpreadsheetDocument spreadsheetDocument = SpreadsheetDocument.Create(ms, SpreadsheetDocumentType.Workbook))
        {
            WorkbookPart workbookPart = spreadsheetDocument.AddWorkbookPart();
            workbookPart.Workbook = new Workbook();

            WorksheetPart worksheetPart = workbookPart.AddNewPart<WorksheetPart>();
            var sheetData = new SheetData();
            worksheetPart.Worksheet = new Worksheet(sheetData);

            // Add header row
            Row headerRow = new Row();
            string[] headers = { "Date", "Product Code", "Product Name", "Price", "Qty", "Total" };
            foreach (var header in headers)
            {
                headerRow.Append(new Cell
                    {
                        DataType = CellValues.String,
                        CellValue = new CellValue(header)
                    });
            }
            sheetData.Append(headerRow);

            // Add data rows
            foreach (var product in p)
            {
                Row dataRow = new Row();

                dataRow.Append(
                    new Cell { DataType = CellValues.String, CellValue = new CellValue(product.date.ToString("yyyy-MM-dd")) },
                    new Cell { DataType = CellValues.String, CellValue = new CellValue(product.code) },
                    new Cell { DataType = CellValues.String, CellValue = new CellValue(product.name) },
                    new Cell { DataType = CellValues.Number, CellValue = new CellValue(product.price.ToString()) },
                    new Cell { DataType = CellValues.Number, CellValue = new CellValue(product.quantity.ToString()) },
                    new Cell { DataType = CellValues.Number, CellValue = new CellValue(product.total.ToString()) }
                );

                sheetData.Append(dataRow);
            }

            Sheets sheets = workbookPart.Workbook.AppendChild(new Sheets());
            Sheet sheet = new Sheet()
                {
                    Id = workbookPart.GetIdOfPart(worksheetPart),
                    SheetId = 1,
                    Name = "SalesReport"
                };
            sheets.Append(sheet);

            workbookPart.Workbook.Save();
        }

        // Export file to browser
        var base64 = Convert.ToBase64String(ms.ToArray());
        await IJS.InvokeVoidAsync("downloadFile", "SalesReport.xlsx", base64);
    }

    private async Task GetSales()
    {
        try
        {
            using (var client = new HttpClient())
            {
                client.BaseAddress = new Uri($"{Nav.BaseUri}");
                var response = await client.GetAsync($"api/Purchase/GetPurchase");
                if (response.IsSuccessStatusCode)
                {
                    await Task.Delay(1000);
                    var contentResponse = await response.Content.ReadAsStringAsync();
                    p = JsonConvert.DeserializeObject<purchase[]>(contentResponse);
                    StateHasChanged();
                }
            }
        }
        catch (Exception ex)
        {
            SnackBar.Add($"Error: {ex.Message}", Severity.Error);
            StateHasChanged();
        }
    }
}